# 后端环境变量示例 —— 复制为 .env 并填入真实值；切勿提交 .env
# 对应 app/core/config.py 的 Settings

# 应用基本信息
APP_NAME=初中跨学科教学评一体化平台
APP_VERSION=0.1.0
DEBUG=true
TESTING=false

# 数据库（开发用 SQLite；生产用 PostgreSQL）
DATABASE_URL=sqlite:///./data/platform.db

# JWT 认证 —— 生产环境必须替换为高强度随机值
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 前端地址（CORS）
FRONTEND_URL=http://localhost:1800

# AI 服务（可选，未配置则 AI 相关功能降级）
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat

# 文件上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_SIZE=5242880
